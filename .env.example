# LLM API Configuration (Planned)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Application Settings
APP_ENV=development
DEBUG=True

# Database Configuration
DATABASE_PATH=data/database/food_guardian.db

# Knowledge Base Configuration
KNOWLEDGE_BASE_PATH=data/knowledge_base/food_knowledge.sample.json
